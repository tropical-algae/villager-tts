# 日志级别；Logging level.
VILLAGER_TTS_LOG_LEVEL=INFO

# API 共享密钥，默认不设置并关闭鉴权；Shared API key, unset by default to disable authentication.
# VILLAGER_TTS_API_KEY=

# RVC 推理设备，可选 auto、cpu 或 cuda；RVC inference device: auto, cpu, or cuda.
VILLAGER_TTS_RVC_DEVICE=auto

# 单个请求允许的最大文本字符数，超出时返回 413；Maximum input characters per request before returning 413.
VILLAGER_TTS_MAX_TEXT_CHARACTERS=1000

# 每个服务进程允许进入合成流水线的最大请求数；Maximum synthesis requests admitted per service process.
VILLAGER_TTS_MAX_CONCURRENT_SYNTHESES=1

# 满载时等待合成槽位的秒数，超时后返回 429；Seconds to wait for a synthesis slot before returning 429.
VILLAGER_TTS_CAPACITY_WAIT_SECONDS=2

# 文本分句时优先采用的目标字符数；Preferred target character count for text segmentation.
VILLAGER_TTS_PHRASE_TARGET_CHARACTERS=80

# 单个 TTS 和 RVC 短语允许的最大字符数；Maximum character count for one TTS and RVC phrase.
VILLAGER_TTS_PHRASE_MAX_CHARACTERS=200

# 每个 TTS 模型实例使用的 CPU 线程数；CPU thread count used by each TTS model instance.
VILLAGER_TTS_TTS_NUM_THREADS=2

# 每种性别预加载的 TTS 模型实例数；Preloaded TTS model instances for each gender.
VILLAGER_TTS_TTS_INSTANCE_COUNT=1

# 单个短语等待并执行 TTS 的总超时秒数；Total timeout in seconds for TTS pool wait and inference per phrase.
VILLAGER_TTS_TTS_REQUEST_TIMEOUT_SECONDS=120

# 常驻 RVC 子进程及完整模型副本数；Persistent RVC subprocesses and complete model replicas.
VILLAGER_TTS_RVC_WORKER_COUNT=1

# RVC 音高偏移的半音数，范围为 -24 到 24；RVC pitch shift in semitones, from -24 to 24.
VILLAGER_TTS_RVC_PITCH=0

# RVC 音高提取方法，可选 rmvpe 或 pm；RVC pitch extraction method: rmvpe or pm.
VILLAGER_TTS_RVC_F0_METHOD=rmvpe

# RVC FAISS 特征检索混合比例，范围为 0 到 1；RVC FAISS feature-retrieval mix ratio, from 0 to 1.
VILLAGER_TTS_RVC_INDEX_RATE=0.75

# RVC 输出音量包络混合比例，范围为 0 到 1；RVC output RMS-envelope mix ratio, from 0 to 1.
VILLAGER_TTS_RVC_RMS_MIX_RATE=1.0

# RVC 清辅音保护比例，范围为 0 到 0.5；RVC consonant-protection ratio, from 0 to 0.5.
VILLAGER_TTS_RVC_PROTECT=0.33

# 单个 RVC worker 启动、加载和预热的超时秒数；Timeout in seconds for one RVC worker to start, load, and warm up.
VILLAGER_TTS_RVC_STARTUP_TIMEOUT_SECONDS=180

# 单个短语等待并执行 RVC 的总超时秒数；Total timeout in seconds for RVC pool wait and inference per phrase.
VILLAGER_TTS_RVC_REQUEST_TIMEOUT_SECONDS=120

# 相邻 RVC 短语之间的交叉淡化毫秒数；Crossfade duration in milliseconds between adjacent RVC phrases.
VILLAGER_TTS_RVC_CROSSFADE_MILLISECONDS=20

# 流式响应每个输出音频块的目标毫秒数；Target duration in milliseconds of each streamed output audio chunk.
VILLAGER_TTS_OUTPUT_CHUNK_MILLISECONDS=200
